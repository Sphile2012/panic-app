
# This flag is public and controls whether account features are enabled in this build.
VITE_AUTH_ENABLED=true
# Server-only config. Never prefix these with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
# Optional; only needed for local Docker deployments.
WHAT3WORDS_API_KEY=
# Frontend callback origin; public site configuration, never an API credential.
VITE_FRONTEND_URL=
