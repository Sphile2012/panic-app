# Copy this file to .env and fill in your Supabase project values.
# Get these from: https://app.supabase.com → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: what3words API key for memorable 3-word location in alert messages.
# Get a free key at: https://developer.what3words.com/
# Leave blank to skip what3words (GPS coordinates + Maps link still sent).
VITE_W3W_API_KEY=
