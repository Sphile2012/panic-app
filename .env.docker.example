# Copy this file to .env.docker.local and replace all GENERATE_* values.
# Do not commit .env.docker.local or use placeholders in a live deployment.
#
# Generate random values with the setup script (`npm run setup`) or a secure
# random password generator. The signed API keys must match JWT_SECRET.

JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET
ANON_KEY=GENERATE_A_KEY_SIGNED_BY_YOUR_JWT_SECRET
SERVICE_ROLE_KEY=GENERATE_A_KEY_SIGNED_BY_YOUR_JWT_SECRET
POSTGRES_PASSWORD=GENERATE_A_UNIQUE_RANDOM_PASSWORD
SECRET_KEY_BASE=GENERATE_A_UNIQUE_RANDOM_SECRET

# Internal Supabase API URL. Browser requests use the app's same-origin proxy.
API_URL=http://localhost:8000
SITE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=

GOTRUE_MAILER_AUTOCONFIRM=true
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=GENERATE_A_UNIQUE_RANDOM_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@panicring.local
WHAT3WORDS_API_KEY=
