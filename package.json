{
  "name": "panic-ring",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":            "vite",
    "build":          "tsc && vite build",
    "preview":        "vite preview --port 4173",
    "typecheck":      "tsc --noEmit",
    "setup":          "node setup.cjs",
    "setup:cloud":    "node setup-cloud.cjs",
    "docker:up":      "docker compose --env-file .env.docker.local up -d --build",
    "docker:down":    "docker compose --env-file .env.docker.local down",
    "docker:reset":   "docker compose --env-file .env.docker.local down -v",
    "docker:logs":    "docker compose --env-file .env.docker.local logs -f",
    "docker:rebuild": "docker compose --env-file .env.docker.local up -d --build app"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "vite":       "5.2.11"
  },
  "engines": {
    "node": ">=20"
  }
}
