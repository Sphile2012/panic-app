{
  "name": "panic-ring",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":            "vite",
    "build":          "npm run build:web && npm run build:mobile && npm run build:api",
    "build:web":       "tsc --noEmit && vite build",
    "build:mobile":    "npm --prefix mobile run build",
    "build:api":       "npm --prefix server run build",
    "preview":        "vite preview --port 4173",
    "typecheck":      "npm run typecheck:web && npm run typecheck:mobile && npm run typecheck:api",
    "typecheck:web":   "tsc --noEmit",
    "typecheck:mobile":"npm --prefix mobile run typecheck",
    "typecheck:api":   "npm --prefix server run typecheck",
    "mobile:dev":      "npm --prefix mobile start",
    "api:dev":         "npm --prefix server run dev",
    "test":            "node --test tests/*.test.mjs",
    "test:api":        "npm --prefix server test",
    "setup":           "node setup.cjs",
    "setup:cloud":     "node setup-cloud.cjs",
    "db:check":        "node scripts/db.mjs check",
    "db:migrate":      "node scripts/db.mjs migrate",
    "db:rollback":     "node scripts/db.mjs rollback",
    "docker:build":   "docker compose --env-file .env.docker.local build",
    "docker:up":      "docker compose --env-file .env.docker.local up -d",
    "docker:down":    "docker compose --env-file .env.docker.local down",
    "docker:logs":    "docker compose --env-file .env.docker.local logs -f app",
    "docker:reset":   "docker compose --env-file .env.docker.local down -v",
    "docker:rebuild": "docker compose --env-file .env.docker.local up -d --build app"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite":       "^5.2.11"
  },
  "engines": {
    "node": ">=20"
  }
}
