############################################################
#  Panic Ring — Docker environment file
#
#  HOW TO USE
#  ----------
#  1. Copy this file:
#       cp .env.docker .env.docker.local
#  2. Fill in EVERY value marked  ← CHANGE THIS
#  3. Run:
#       docker compose --env-file .env.docker.local up -d --build
#
#  SECRETS
#  -------
#  Generate JWT_SECRET:
#    openssl rand -base64 32
#
#  Generate SECRET_KEY_BASE:
#    openssl rand -hex 32
#
#  Generate POSTGRES_PASSWORD:
#    openssl rand -base64 24
#
#  Regenerate ANON_KEY / SERVICE_ROLE_KEY after changing JWT_SECRET:
#    https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#
#  NEVER commit .env.docker.local to version control.
############################################################


# ── JWT ──────────────────────────────────────────────────
# Must be at least 32 characters. Change before deploying.
JWT_SECRET=super-secret-jwt-token-at-least-32-characters-long    # ← CHANGE THIS


# ── Supabase API keys (signed JWTs) ──────────────────────
# These are baked into the browser app — they are public by design.
# Security is enforced by Row Level Security in Postgres.
# The values below are the standard Supabase local-dev defaults.
# If you change JWT_SECRET, regenerate these.

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxOTU3MzQ1MjAwfQ.dc_X5iR_VP_qroQvDRwEpsy_ZN4hJuOFJEaBkVRIpNk

SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjQxNzY5MjAwLCJleHAiOjE5NTczNDUyMDB9.iaF2TIc1jBgHVQ0Lxvzlqrh8I7p6wZBXp5D3mfNLrVU


# ── Postgres ──────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-postgres-password            # ← CHANGE THIS


# ── Realtime ──────────────────────────────────────────────
SECRET_KEY_BASE=your-secret-key-base-hex-string-at-least-64-chars  # ← CHANGE THIS


# ── URLs ──────────────────────────────────────────────────
# Kong API gateway — browsers reach Supabase through this URL.
# Local:      http://localhost:8000
# Production: https://api.yourdomain.com
API_URL=http://localhost:8000

# The public URL of the Panic Ring app (used for email confirmation links).
# Local:      http://localhost:8080
# Production: https://app.yourdomain.com
SITE_URL=http://localhost:8080


# ── Studio ────────────────────────────────────────────────
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=changeme                                       # ← CHANGE THIS


# ── SMTP (optional) ───────────────────────────────────────
# Leave blank → Supabase auto-confirms all signups (good for local dev).
# Fill in for production so users receive email confirmation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@panicring.local


# ── what3words (optional) ─────────────────────────────────
# Free key at https://developer.what3words.com/
# Leave blank to skip what3words in alert messages.
VITE_W3W_API_KEY=
